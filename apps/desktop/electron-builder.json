{
  "appId": "dev.gridloc.chordinal",
  "productName": "Chordinal",
  "asar": false,
  "afterPack": "fuses.mjs",
  "directories": {
    "output": "../../release/chordinal",
    "buildResources": "assets/icon"
  },
  "files": ["dist/**", "!dist/**/*.map", "!dist/types/**", "assets/icon/icon.png", "package.json"],
  "extraResources": [
    {
      "from": "../web/dist",
      "to": "web",
      "filter": ["**/*", "!**/*.map"]
    },
    {
      "from": "../../soundfonts/GeneralUser-GS",
      "to": "soundfonts/GeneralUser-GS"
    },
    {
      "from": "../../docs",
      "to": "docs"
    },
    {
      "from": "../../README.md",
      "to": "README.md"
    },
    {
      "from": "../../LICENSE",
      "to": "LICENSE"
    }
  ],
  "fileAssociations": [
    {
      "ext": ["mid", "midi", "smf"],
      "name": "MIDI File",
      "description": "Standard MIDI file",
      "mimeType": "audio/midi",
      "role": "Editor",
      "rank": "Alternate"
    }
  ],
  "mac": {
    "category": "public.app-category.music",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": "assets/icon/icon.icns",
    "identity": "-",
    "hardenedRuntime": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Chordinal listens to the microphone to turn the melodies and chords you record into notes."
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": ["flatpak"],
    "category": "Audio",
    "icon": "assets/icon/icon.png"
  },
  "flatpak": {
    "runtimeVersion": "25.08",
    "baseVersion": "25.08",
    "finishArgs": [
      "--socket=wayland",
      "--socket=x11",
      "--share=ipc",
      "--device=dri",
      "--socket=pulseaudio",
      "--share=network",
      "--filesystem=home"
    ]
  },
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "extraMetadata": {
    "name": "chordinal",
    "productName": "Chordinal",
    "main": "dist/chordinal.js"
  }
}
