{
  "compilerOptions": {
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "packages/*/src/**/*.js",
    "packages/*/src/**/*.jsx",
    "apps/web/src/**/*.js",
    "apps/web/src/**/*.jsx"
  ]
}
