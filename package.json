{
  "name": "chordinal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Write, record and arrange music: a small DAW with a sketchpad that turns recorded melodies into notes",
  "author": "gridlocdev",
  "homepage": "https://github.com/gridlocdev/chordinal",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test 'test/**/*.test.js' && vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm e2e"
  },
  "devDependencies": {
    "@chordinal/audio": "workspace:*",
    "@chordinal/daw": "workspace:*",
    "@chordinal/desktop": "workspace:*",
    "@chordinal/lib": "workspace:*",
    "@chordinal/perform": "workspace:*",
    "@chordinal/playback": "workspace:*",
    "@chordinal/sketch": "workspace:*",
    "@chordinal/ui": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/signals": "2.11.4",
    "@types/node": "22.20.5",
    "electron": "44.9.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright-core": "1.64.1",
    "preact": "11.2.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
